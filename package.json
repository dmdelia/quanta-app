{
  "name": "quanta-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet desktop notebook for scientific thinking.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "build:web": "node scripts/prepare-web.mjs && npm run build && node scripts/finish-web.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b && vitest run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "engine:prepare": "node scripts/prepare-engine.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dompurify": "^3.3.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "katex": "^0.16.28",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.3",
    "mathlive": "0.111.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "2.12.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
