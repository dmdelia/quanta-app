{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QUANTA", "version": "0.1.0", "identifier": "com.quanta.notebook",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "QUANTA", "width": 1280, "height": 840, "minWidth": 820, "minHeight": 560, "center": true, "backgroundColor": "#edf1f5", "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:; worker-src 'self' blob:; frame-src blob:; object-src 'none'" }
  },
  "bundle": {
    "active": true, "targets": ["app", "dmg", "nsis"], "category": "Productivity",
    "shortDescription": "A quiet notebook for scientific thinking",
    "longDescription": "QUANTA combines visual mathematics, Markdown, and LaTeX in a fast, local-first scientific notebook.",
    "copyright": "Copyright 2026 QUANTA",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/tectonic"],
    "resources": {"resources/tex-cache/": "tex-cache/"},
    "macOS": { "minimumSystemVersion": "13.0" },
    "windows": { "nsis": { "displayLanguageSelector": false, "languages": ["English", "German"], "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
